# 【开发】环境变量

# 应用部署基础路径
VITE_BASE_URL = /

# API 请求地址（开发环境直接请求后端地址）
VITE_API_URL = http://localhost:7589

# API 请求前缀（开发环境为空，生产环境可设置为 /api）
VITE_API_PREFIX =

# 是否开启数据mock
VITE_USE_MOCK=false

# Token Key
VITE_TOKEN_KEY=Authorization

# 是否开启调试工具
VITE_USE_ERUDA=true

# 是否开启压缩
VITE_USE_COMPRESS=false

# 是否开启打包后生成报告
VITE_USE_REPORT=false

# 是否开启https
VITE_USE_HTTPS=false

# 是否开启PWA
VITE_USE_PWA=false

# 是否开启接口加密（开发环境建议关闭）
VITE_API_ENCRYPT = false