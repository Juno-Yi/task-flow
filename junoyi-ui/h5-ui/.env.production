# 【生产】环境变量

# 应用部署基础路径
VITE_BASE_URL = /

# API 请求地址（生产环境可以是相对路径 / 或完整地址）
VITE_API_URL = /

# API 请求前缀（生产环境通过 nginx 代理，可设置为 /api 等）
VITE_API_PREFIX = /api

# 是否开启数据mock
VITE_USE_MOCK=false

# Token Key
VITE_TOKEN_KEY=Authorization

# 是否开启调试工具
VITE_USE_ERUDA=false

# 是否开启压缩
VITE_USE_COMPRESS=true

# 是否开启打包后生成报告
VITE_USE_REPORT=false

# 是否开启https
VITE_USE_HTTPS=false

# 是否开启PWA
VITE_USE_PWA=false

# 是否开启接口加密（生产环境建议开启）
VITE_API_ENCRYPT = false